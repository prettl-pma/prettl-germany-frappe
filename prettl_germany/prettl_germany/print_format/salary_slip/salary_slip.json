 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n    .salary-container {\r\n        font-family: Arial, sans-serif;\r\n        font-size: 13px;\r\n        padding: 20px;\r\n    }\r\n\r\n    .header-title {\r\n        font-size: 20px;\r\n        font-weight: bold;\r\n    }\r\n\r\n.header-section {\r\n    position: relative;\r\n    margin-bottom: 10px;\r\n}\r\n\r\n.company-logo {\r\n    position: absolute;\r\n    top: 0;\r\n    right: 0;\r\n    height: 70px;   \r\n}\r\n\r\n.company-info {\r\n    padding-right: 140px;  /* space so text doesn\u2019t overlap logo */\r\n}\r\n\r\n    .sub-title {\r\n        font-size: 16px;\r\n        font-weight: bold;\r\n        text-align: center;\r\n        margin-top: 10px;\r\n        margin-bottom: 20px;\r\n    }\r\n\r\n    .box {\r\n        border: 2px solid #000;\r\n        padding: 10px;\r\n        margin-bottom: 15px;\r\n    }\r\n    .table-border {\r\n    border: 2px solid #000;       /* Outer border */\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n}\r\n\r\n/* Remove all borders */\r\n.table-border th,\r\n.table-border td {\r\n    border: none;\r\n    padding: 1px 6px;\r\n    line-height: 1.0;      /* tighter rows */\r\n    color: #000;\r\n}\r\n\r\n\r\n/* Only headers bold */\r\n.table-border th {\r\n    font-weight: bold;\r\n}\r\n\r\n\r\n/* Vertical center divider only */\r\n.table-border th:nth-child(3),\r\n.table-border td:nth-child(3) {\r\n    border-left: 1px solid #000;\r\n}\r\n\r\n/* Header bottom line */\r\n.table-border tr:first-child th {\r\n    border-bottom: 1px solid #000;\r\n}\r\n\r\n/* Total row top border */\r\n.table-border tr.total-row td {\r\n    border-top: 1px solid #000;\r\n}\r\n\r\n/* Net row top border */\r\n.table-border tr.net-row td {\r\n    border-top: 1px solid #000;\r\n}\r\n\r\n\r\n/* Center vertical divider (between earnings & deductions) */\r\n.table-border th:nth-child(3),\r\n.table-border td:nth-child(3) {\r\n    border-left: 1px solid #000;\r\n}\r\n\r\n    \r\n\r\n    .right {\r\n        text-align: right;\r\n    }\r\n\r\n    .bold {\r\n        font-weight: bold;\r\n    }\r\n   .employee-table {\r\n    width: 100%;\r\n    border: 2px solid #000;\r\n    border-collapse: collapse;\r\n}\r\n\r\n\r\n/* Only center vertical divider */\r\n.employee-table > tbody > tr > td:first-child {\r\n    border-right: 1px solid #000;\r\n}\r\n\r\n/* Inner tables */\r\n.inner-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n}\r\n\r\n.inner-table td {\r\n    padding: 0px 4px;   /* zero vertical padding - maximum compactness */\r\n    border: none;       /* no vertical borders */\r\n    line-height: 1.0;/* absolute minimum height for extremely compact rows */\r\n    font-size: 12.5px;\r\n}\r\n.employee-table,\r\n.employee-table td,\r\n.inner-table td {\r\n    color: #000 !important;\r\n}\r\n.employee-table > tbody > tr > td {\r\n    padding: 0px 3px;\r\n    vertical-align: top;\r\n}\r\n\r\n\r\n\r\n</style>\r\n\r\n<div class=\"salary-container\">\r\n\r\n    {% set employee = frappe.get_doc(\"Employee\", doc.employee) %}\r\n\r\n    <!-- Header -->\r\n    <div class=\"header-section\">\r\n\r\n    <img src=\"/files/Prebo Company.png\" class=\"company-logo\">\r\n\r\n    <div class=\"company-info\">\r\n        <div class=\"header-title\">PreBo Automotive Private Limited</div>\r\n        <div>No 5, Kumbalgodu Industrial Area, Bangalore - 560074</div>\r\n    </div>\r\n\r\n</div>\r\n\r\n\r\n    <div class=\"sub-title\">\r\n        Payslip for the month of : {{ frappe.utils.formatdate(doc.start_date, \"MMM-yyyy\") }}\r\n    </div>\r\n\r\n    <!-- Employee Info Box -->\r\n   <table class=\"employee-table\">\r\n    <tr>\r\n        <!-- LEFT SIDE -->\r\n        <td width=\"50%\">\r\n            <table class=\"inner-table\">\r\n                <tr>\r\n                    <td width=\"38%\">Employee Code</td>\r\n                    <td width=\"4%\">:</td>\r\n                    <td width=\"58%\">{{ doc.employee }}</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>Name</td>\r\n                    <td>:</td>\r\n                    <td>{{ employee.employee_name }}</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>Designation</td>\r\n                    <td>:</td>\r\n                    <td>{{ doc.designation or \"\" }}</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>Department</td>\r\n                    <td>:</td>\r\n                    <td>{{ doc.department or \"\" }}</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>Location</td>\r\n                    <td>:</td>\r\n                    <td>{{ doc.branch or \"\" }}</td>\r\n                </tr>\r\n            </table>\r\n        </td>\r\n\r\n        <!-- RIGHT SIDE -->\r\n        <td width=\"50%\">\r\n            <table class=\"inner-table\">\r\n                <tr>\r\n                    <td width=\"45%\">PF Account Number</td>\r\n                    <td width=\"4%\">:</td>\r\n                    <td width=\"51%\">{{ employee.provident_fund_account or \"N/A\" }}</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>UAN</td>\r\n                    <td>:</td>\r\n                    <td>{{ employee.custom_uan_number or \"N/A\" }}</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>PAN Number</td>\r\n                    <td>:</td>\r\n                    <td>{{ employee.pan_number or \"N/A\" }}</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>Bank Detail</td>\r\n                    <td>:</td>\r\n                    <td>{{ doc.bank_name or \"\" }} - {{ doc.bank_account_no or \"\" }}</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>ESI Number</td>\r\n                    <td>:</td>\r\n                    <td>{{ employee.esi_number or \"N/A\" }}</td>\r\n                </tr>\r\n            </table>\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n\r\n\r\n\r\n    <br>\r\n\r\n    <!-- Earnings & Deductions -->\r\n    <table class=\"table-border\">\r\n        <tr>\r\n    <th width=\"35%\" class=\"bold\">Earnings</th>\r\n    <th width=\"15%\" class=\"right\">Amount (Rs)</th>\r\n    <th width=\"35%\" class=\"bold\">Deductions</th>\r\n    <th width=\"15%\" class=\"right\">Amount (Rs)</th>\r\n</tr>\r\n\r\n\r\n        {% set max_rows = [doc.earnings|length, doc.deductions|length]|max %}\r\n\r\n        {% for i in range(max_rows) %}\r\n        <tr>\r\n            <td>\r\n                {% if doc.earnings|length > i %}\r\n                    {{ doc.earnings[i].salary_component }}\r\n                {% endif %}\r\n            </td>\r\n            <td class=\"right\">\r\n                {% if doc.earnings|length > i %}\r\n                    {{ \"{:,.2f}\".format(doc.earnings[i].amount) }}\r\n                {% endif %}\r\n            </td>\r\n\r\n            <td>\r\n                {% if doc.deductions|length > i %}\r\n                    {{ doc.deductions[i].salary_component }}\r\n                {% endif %}\r\n            </td>\r\n            <td class=\"right\">\r\n                {% if doc.deductions|length > i %}\r\n                    {{ \"{:,.2f}\".format(doc.deductions[i].amount) }}\r\n                {% endif %}\r\n            </td>\r\n        </tr>\r\n        {% endfor %}\r\n\r\n        <!-- Totals -->\r\n        <tr class=\"bold total-row\">\r\n            <td>Total (Rs.)</td>\r\n            <td class=\"right\">{{ \"{:,.2f}\".format(doc.gross_pay) }}</td>\r\n            <td>Total (Rs.)</td>\r\n            <td class=\"right\">{{ \"{:,.2f}\".format(doc.total_deduction) }}</td>\r\n        </tr>\r\n\r\n        <tr class=\"bold net-row\">\r\n            <td colspan=\"3\" class=\"right\">Net Amount :</td>\r\n            <td class=\"right\">{{ \"{:,.2f}\".format(doc.net_pay) }}</td>\r\n        </tr>\r\n    </table>\r\n\r\n    <br><br>\r\n\r\n    <div>\r\n        <b>Note :</b><br>\r\n        \"This payslip is computer generated, hence no signature is required\"\r\n    </div>\r\n\r\n</div>",
